<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/launcher_fragment">

    <!-- Global actions. The drawer is reachable from every screen, and an action declared inside
         one destination resolves only from that destination, so a drawer tap anywhere but the home
         screen used to throw IllegalArgumentException. The ids are unchanged. -->
    <action
        android:id="@id/action_open_settings_fragment"
        app:destination="@id/app_settings_fragment"/>
    <action
        android:id="@+id/action_open_instance_settings"
        app:destination="@id/settings_fragment"/>
    <action
        android:id="@id/action_open_gamepad_mapper"
        app:destination="@id/gamepad_mapper_fragment"/>
    <action
        android:id="@+id/action_open_wiki_fragment"
        app:destination="@id/wiki_fragment"/>
    <action
        android:id="@+id/action_install_controls"
        app:destination="@id/installControlsFragment" />
    <action
        android:id="@+id/action_export_log"
        app:destination="@id/export_log_fragment" />
    <action
        android:id="@+id/action_open_bug_report"
        app:destination="@id/bug_report_fragment" />
    <action
        android:id="@+id/action_open_transfer"
        app:destination="@id/transfer_fragment" />
    <action
        android:id="@+id/action_open_mods"
        app:destination="@id/mods_fragment" />
    <!-- The Workshop hands its queue to the Game page, which signs in to Steam and downloads -->
    <action
        android:id="@+id/action_download_mods"
        app:destination="@id/download_fragment" />

    <!-- The bottom bar's pages (as in RimDroid): the bar's item ids are these destination ids. -->
    <fragment
        android:id="@+id/download_fragment"
        android:name="com.udarmolota.syxdroid.fragments.DownloadFragment"
        android:label="@string/steam_title"
        tools:layout="@layout/fragment_download" />

    <fragment
        android:id="@+id/workshop_fragment"
        android:name="com.udarmolota.syxdroid.fragments.WorkshopFragment"
        android:label="@string/workshop_title"
        tools:layout="@layout/fragment_workshop" />

    <!-- Mods of an instance, from the side menu (as in RimDroid) -->
    <fragment
        android:id="@+id/mods_fragment"
        android:name="com.udarmolota.syxdroid.fragments.ModsFragment"
        android:label="@string/nav_mods"
        tools:layout="@layout/fragment_mods" />

    <fragment
        android:id="@+id/transfer_fragment"
        android:name="com.udarmolota.syxdroid.fragments.TransferFragment"
        android:label="@string/transfer_title"
        tools:layout="@layout/fragment_transfer" />

    <fragment
        android:id="@+id/projects_fragment"
        android:name="com.udarmolota.syxdroid.fragments.ProjectsFragment"
        android:label="@string/projects_title"
        tools:layout="@layout/fragment_projects" />

    <!-- Report a bug: one screen, by email or saved to a file (as in RimDroid) -->
    <fragment
        android:id="@+id/bug_report_fragment"
        android:name="com.udarmolota.syxdroid.fragments.BugReportFragment"
        android:label="@string/bug_report_title"
        tools:layout="@layout/fragment_bug_report" />

    <fragment
        android:id="@+id/launcher_fragment"
        android:name="com.udarmolota.syxdroid.fragments.LauncherFragment"
        android:label="@string/fragment_label_launcher"
        tools:layout="@layout/fragment_launcher" />

    <!-- Per-instance launch settings, opened by the gear on an instance card. The argument is
         nullable so the screen still works if something navigates here without one; it then reads
         and writes the app-wide fallbacks. -->
    <fragment
        android:id="@+id/settings_fragment"
        android:name="com.udarmolota.syxdroid.fragments.SettingsFragment"
        android:label="@string/fragment_label_instance_settings"
        tools:layout="@layout/fragment_settings">
        <argument
            android:name="instance"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- App-wide settings: the theme, and nothing else. -->
    <fragment
        android:id="@+id/app_settings_fragment"
        android:name="com.udarmolota.syxdroid.fragments.AppSettingsFragment"
        android:label="@string/fragment_label_settings"
        tools:layout="@layout/fragment_app_settings">
    </fragment>

    <fragment
        android:id="@+id/gamepad_mapper_fragment"
        android:name="com.udarmolota.syxdroid.fragments.GamepadMapperFragment"
        android:label="@string/nav_menu_gamepad_mapper"
        tools:layout="@layout/fragment_gamepad_mapper">
    </fragment>

    <fragment
        android:id="@+id/wiki_fragment"
        android:name="com.udarmolota.syxdroid.fragments.WikiFragment"
        android:label="@string/fragment_label_wiki">
    </fragment>

    <fragment
        android:id="@+id/installControlsFragment"
        android:name="com.udarmolota.syxdroid.fragments.InstallControlsFragment"
        android:label="@string/menu_install_controls"
        tools:layout="@layout/fragment_install_controls" />

    <fragment
        android:id="@+id/export_log_fragment"
        android:name="com.udarmolota.syxdroid.fragments.ExportLogFragment"
        android:label="@string/export_log_menu" />

</navigation>