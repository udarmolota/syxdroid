<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <group android:id="@+id/group_controls" android:checkableBehavior="none">
        <!-- New instance first, as in RimDroid -->
        <item
            android:id="@+id/action_new_instance"
            android:title="@string/syx_new_instance_title"
            android:icon="@drawable/mt_icon_add"
            app:showAsAction="never"/>
        <item
            android:id="@+id/action_open_settings_fragment"
            android:title="@string/fragment_label_settings"
            android:icon="@drawable/mt_icon_settings"
            app:showAsAction="never"/>
        <item
            android:id="@+id/action_open_controls_editor"
            android:title="@string/nav_menu_controls_editor"
            android:icon="@drawable/ic_controls"
            app:showAsAction="never"/>
        <!-- Hidden: Songs of Syx has no gamepad support of its own (no joystick code at all), so
             mapping gamepad buttons leads nowhere. The id stays: the nav graph's action uses it. -->
        <item
            android:id="@+id/action_open_gamepad_mapper"
            android:visible="false"
            android:title="@string/nav_menu_gamepad_mapper"
            android:icon="@drawable/mt_icon_controller"
            app:showAsAction="never"/>
    </group>

    <group android:id="@+id/group_files" android:checkableBehavior="none">
        <item
            android:id="@+id/action_install_controls"
            android:title="@string/menu_install_controls"
            android:icon="@drawable/ic_controls"
            app:showAsAction="never"/>
        <item
            android:id="@+id/action_install_driver"
            android:title="@string/install_driver_menu"
            android:icon="@drawable/mt_icon_driver"
            app:showAsAction="never"/>
        <!-- "Export log" is part of Report a bug now: one screen, by email or saved to a file -->
        <item
            android:id="@+id/action_bug_report"
            android:title="@string/nav_bug_report"
            android:icon="@drawable/ic_bug_report"
            app:showAsAction="never"/>
    </group>

    <!-- Wiki / Donate / Reddit / Version moved to the bottom icon row in activity_launcher.xml -->


</menu>